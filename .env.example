# Copy this file to .env.local for local development.
# On Vercel add the same two variables in Project → Settings → Environment Variables.
# Find both values in Supabase Dashboard → Project Settings → API (Data API / API Keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Either the legacy "anon public" key or the new "publishable" key works here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
